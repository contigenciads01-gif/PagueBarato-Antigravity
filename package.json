    "calc:margem": "tsx scripts/calc-margem.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "decimal.js": "^10.4.3",
    "drizzle-orm": "^0.36.4",
    "konva": "^10.9.1",
    "lucide-react": "^1.66.0",
    "next": "^15.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-konva": "^19.3.2",
    "zod": "^3.23.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "@img/sharp-win32-x64",
      "@next/swc-win32-x64-msvc"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",

    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
